  "content": {
    "home": [
      {
        "id": "source:home",
        "slug": "home",
        "status": "draft",
        "data": {
          "source_key": "source:home",
          "title": "Home",
          "identity": "home",
          "introduction": "Oleo-based, synthetic, and biodegradable surfactant solutions for customers worldwide, backed by 100 years of expertise, integrated oleochemical strength, and manufacturing in Europe and Asia.",
          "intro_heading": "Global Surfactant\nManufacturer and Supplier",
          "help_heading": "How Can We Help",
          "portfolio_heading": "Surfactants Portfolio",
          "portfolio_copy": "KLK OLEO Surfactants supplies global customers with non-ionic, anionic, and cationic surfactants, including ethoxylated and alkoxylated surfactants, tailored specialty surfactants, and custom chemical manufacturing solutions.",
          "portfolio_instruction": "Use our Product Explorer to navigate our diverse portfolio and identify the best fit for your application.",
          "markets_heading": "Markets We Serve",
          "markets_copy": "Oleo-based and synthetic solutions for key industries where performance and reliability matter. Functions include wetting, foaming, emulsifying, cleaning, dispersion, and stability, designed to deliver consistent results at scale.",
          "partner_heading": "Your Partner of Choice for Surfactants",
          "partner_copy": "KLK OLEO is one of the world's largest vertically integrated oleochemicals manufacturers, giving you direct access to oleochemicals and their derivatives, raw material security, global production capacity, and consistent supply.",
          "video_heading": "From development to full-scale production",
          "quality_heading": "High Standard, High Trust",
          "quality_copy": "Our ISO-certified quality systems and full documentation support make audits and approvals straightforward for our customers.",
          "award_title": "Shell Gold Award for Operational Excellence",
          "award_copy": "We are proud to be recognised for award-winning operations, with 24-hour responsiveness, proactive supply reliability, and co-created solutions, backed by ISO-certified management systems and a Platinum EcoVadis rating.",
          "news_heading": "Latest News",
          "news_copy": "Stay informed with the latest announcements, exhibitions, and milestones from KLK OLEO Surfactants. Explore how we continue to advance innovation and sustainability across our business.",
          "faq_heading": "Frequently Asked Questions",
          "hero_slides": [
            {
              "title": "100 YEARS",
              "copy": "A Century of Surfactant Excellence.",
              "image": {
                "id": "/images/hero/hero-01-100-years.jpg",
                "src": "/images/hero/hero-01-100-years.jpg",
                "alt": "A historic gathering beside a steam train",
                "provider": "external",
                "mimeType": "image/jpeg"
              },
              "alt": "A historic gathering beside a steam train",
              "action": "Read More",
              "kind": "article",
              "target": "century",
              "position": "50% 45%"
            },
            {
              "title": "SUSTAINABILITY IN ACTION",
              "copy": "20% more capacity and 30% less CO₂ emissions.",
              "image": {
                "id": "/images/hero/hero-02-sustainability.jpg",
                "src": "/images/hero/hero-02-sustainability.jpg",
                "alt": "A glass globe resting among green plants",
                "provider": "external",
                "mimeType": "image/jpeg"
              },
              "alt": "A glass globe resting among green plants",
              "action": "Read More",
              "kind": "article",
              "target": "sustainability",
              "position": "65% 50%"
            },
            {
              "title": "CUSTOM MANUFACTURING THAT BRINGS YOUR IDEAS TO LIFE",
              "copy": "Scale-up, quality, and long-term capacity built around your needs.",
              "image": {
                "id": "/images/hero/hero-03-custom-manufacturing.jpg",
                "src": "/images/hero/hero-03-custom-manufacturing.jpg",
                "alt": "Stainless steel manufacturing tanks and walkways",
                "provider": "external",
                "mimeType": "image/jpeg"
              },
              "alt": "Stainless steel manufacturing tanks and walkways",
              "action": "Read More",
              "kind": "deferred",
              "target": "Custom Manufacturing",
              "position": "60% 50%"
            },
            {
              "title": "OUR MARKETS",
              "copy": "High-impact surfactants for every market we serve. Designed for performance, built for reliable scale-up.",
              "image": {
                "id": "/images/hero/hero-04-our-markets.jpg",
                "src": "/images/hero/hero-04-our-markets.jpg",
                "alt": "Personal care packaging with cotton and natural materials",
                "provider": "external",
                "mimeType": "image/jpeg"
              },
              "alt": "Personal care packaging with cotton and natural materials",
              "action": "Explore Our Markets",
              "kind": "anchor",
              "target": "#markets-we-serve",
              "position": "65% 50%"
            },
            {
              "title": "FROM LAB IDEA TO 1,000 KG BATCH",
