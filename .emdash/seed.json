    "faqs": [
      {
        "id": "source:faq-1",
        "slug": "faq-1",
        "status": "draft",
        "data": {
          "source_key": "source:faq-1",
          "title": "What does KLK OLEO Surfactants manufacture?",
          "answer": "KLK OLEO Surfactants manufactures industrial and specialty surfactants for a wide range of applications. Our portfolio includes nonionic, anionic, and cationic surfactants, as well as tailored customer-specific solutions designed for performance, consistency, and reliable supply.",
          "order": 0
        }
      },
      {
        "id": "source:faq-2",
        "slug": "faq-2",
        "status": "draft",
        "data": {
          "source_key": "source:faq-2",
          "title": "Is KLK OLEO Surfactants part of an oleochemical manufacturing group?",
          "answer": "Yes. KLK OLEO Surfactants is part of KLK OLEO, one of the world’s largest vertically integrated oleochemical groups. This integration supports raw material security, supply continuity, and the development of oleo-based surfactant solutions for global markets. Nevertheless, we also supply surfactants based on synthetic fatty alcohols.",
          "order": 1
        }
      },
      {
        "id": "source:faq-3",
        "slug": "faq-3",
        "status": "draft",
        "data": {
          "source_key": "source:faq-3",
          "title": "How does KLK OLEO Surfactants support industrial chemical supply?",
          "answer": "We support reliable industrial chemical supply through integrated oleochemical sourcing, diversified manufacturing, technical documentation, and global supply capabilities.",
          "order": 2
        }
      },
      {
        "id": "source:faq-4",
        "slug": "faq-4",
        "status": "draft",
        "data": {
          "source_key": "source:faq-4",
          "title": "Does KLK OLEO Surfactants offer custom chemical manufacturing?",
          "answer": "Yes. We provide custom chemical manufacturing and tailored production support for customers who need specific performance profiles, blends, or manufacturing routes. Our teams support projects from product selection and development through to industrial production.",
          "order": 3
        }
      },
      {
        "id": "source:faq-5",
        "slug": "faq-5",
        "status": "draft",
        "data": {
          "source_key": "source:faq-5",
          "title": "Can KLK OLEO Surfactants support scale-up from lab trials to industrial production?",
          "answer": "Yes. KLK OLEO Surfactants supports scale-up from early development through to full industrial production. We help reduce scale-up risk with technical support, process know-how, and manufacturing capabilities designed to move formulations forward efficiently.",
          "order": 4
        }
      }
