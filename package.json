{
  "name": "klk-oleo-surfactants",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "lint": "eslint src tests",
    "typecheck": "astro check",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "astro preview --host 127.0.0.1",
    "test:browser": "playwright test",
    "cms:seed": "node --import tsx scripts/import-content.ts",
    "cms:backup": "node scripts/local-backup.mjs backup",
    "cms:restore": "node scripts/local-backup.mjs restore"
  },
  "dependencies": {
    "@emdash-cms/auth": "1.4.0",
    "@astrojs/node": "11.1.11",
    "@astrojs/react": "7.1.5",
    "astro": "7.4.8",
    "emdash": "1.4.0",
    "kysely": "0.29.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "zod": "4.6.7"
  },
  "overrides": { "zod": "$zod" },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "tsx": "4.23.15",
    "typescript": "^5",
    "typescript-eslint": "8.72.2"
  },
  "exports": {
    "./cms-plugin": "./src/cms/plugin.ts",
    "./enquiries-plugin": "./src/enquiries/plugin.ts",
    "./enquiries-admin": "./src/enquiries/admin.tsx"
  }
}
