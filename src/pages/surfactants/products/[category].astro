---
import Layout from '../../../layouts/SiteLayout.astro';
import { CategoryPage } from '../../../views/category-page';
import { categories } from '../../../lib/catalog';
const category = Astro.params.category!;
if (!categories.some(item => item.slug === category)) return Astro.rewrite('/404');
---
<Layout title="Products | KLK OLEO Surfactants"><CategoryPage category={category} client:load /></Layout>
