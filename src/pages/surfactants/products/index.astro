---
import Layout from '../../../layouts/SiteLayout.astro';
import { PageIsland } from '../../../components/site-islands';
import { loadSiteContent } from '../../../cms/published';
const {data} = await loadSiteContent();
---
<Layout data={data} title={data.pages["products"]?.seoTitle || "Our Products | KLK OLEO Surfactants"} description={data.pages["products"]?.seoDescription || undefined}><PageIsland data={data} view="products"  client:load /></Layout>
