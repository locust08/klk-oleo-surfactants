---
import { getEmDashEntry } from 'emdash';
import { PortableText } from 'emdash/ui';
import Layout from '../../../layouts/SiteLayout.astro';
import { loadSiteContent } from '../../../cms/published';
import { resolveCmsMedia } from '../../../cms/media';
import { normalizeNewsCategory } from '../../../cms/news-categories';
import { articleRedirect } from '../../../cms/legacy-routes';
import { articleSections } from '../../../cms/article-body';
import type { Media } from '../../../cms/types';
const legacy = articleRedirect(Astro.params.slug!);
if (legacy) return Astro.redirect(legacy, 301);
const {entry, isPreview, error} = await getEmDashEntry('news', Astro.params.slug!);
if (error) throw error;
if (!entry || (!isPreview && (!Array.isArray(entry.data.body) || !entry.data.body.length || !entry.data.publication_date))) return Astro.rewrite('/404');
const {data} = await loadSiteContent(Astro.locals.emdash?.getPublicMediaUrl);
const slug = String(entry.data.slug || Astro.params.slug);
const body = Array.isArray(entry.data.body) ? entry.data.body : [];
const sections = articleSections(body);
const date = entry.data.publication_date ? String(entry.data.publication_date) : '';
const image = resolveCmsMedia(entry.data.image, Astro.locals.emdash?.getPublicMediaUrl);
const related = data.articles.find(item => item.slug !== slug && item.body?.length && item.publishedAt);
---
<Layout data={data} title={String(entry.data.seo_title || `${entry.data.title} | KLK OLEO Surfactants`)} description={String(entry.data.seo_description || entry.data.summary || '')}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><div class="container"><a href="/surfactants">Home</a><span><span aria-hidden="true"> › </span><a href="/surfactants/news-media">News &amp; Media</a></span><span><span aria-hidden="true"> › </span><span aria-current="page">{entry.data.title}</span></span></div></nav>
  <article class="editorial-article" {...entry.edit}>
    <header class="article-heading container">
      <a class="text-link" href="/surfactants/news-media"><span aria-hidden="true">←</span> Back to News &amp; Media</a>
      <div class="article-meta"><span class="eyebrow">{normalizeNewsCategory(entry.data.category)}</span>{date && <time datetime={date.slice(0, 10)}>{new Date(date).toLocaleDateString('en-GB', {day:'numeric', month:'long', year:'numeric', timeZone:'UTC'})}</time>}</div>
      <h1 {...entry.edit.title}>{entry.data.title}</h1>
    </header>
    {image && <figure class="article-cover container"><img src={image} alt={(entry.data.image as Media)?.alt || ''} fetchpriority="high" style="position:absolute;inset:0;width:100%;height:100%" /></figure>}
    <div class="article-layout container">
      <aside class="article-contents"><nav aria-label="In this article"><span class="eyebrow">In this article</span>{sections.filter(section => section.heading).map(section => <a href={`#${section.id}`}>{section.heading}</a>)}</nav></aside>
      <div class="article-body" {...entry.edit.body}>
        {slug === 'sustainability' && <div class="article-impact" aria-label="Moerdijk expansion targets"><div><strong>20%</strong><span>Planned increase in production capacity</span></div><div><strong>30%</strong><span>Targeted reduction in carbon emissions</span></div></div>}
        {isPreview ? <PortableText value={body} /> : sections.map(section => <>{section.heading && <span class="article-anchor" id={section.id} />}<PortableText value={section.blocks} /></>)}
        {related && <div class="article-end"><span class="eyebrow">Continue reading</span><a href={`/surfactants/news-media/${related.slug}`}><span>{related.title}</span><span aria-hidden="true">→</span></a></div>}
      </div>
    </div>
  </article>
</Layout>
<style is:global>.article-anchor{display:block;scroll-margin-top:125px}.article-body>.article-anchor:first-child+h2{margin-top:0}.article-body a{text-decoration:underline}</style>
