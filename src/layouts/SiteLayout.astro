---
import '../styles/globals.css';
import { HeaderIsland, FooterIsland } from '../components/site-islands';
import { loadSiteContent } from '../cms/published';
import type { SiteData } from '../cms/types';
interface Props { title: string; description?: string; data?: SiteData; }
const { title, description = 'Global surfactant solutions from KLK OLEO.' } = Astro.props;
const data = Astro.props.data || (await loadSiteContent(Astro.locals.emdash?.getPublicMediaUrl)).data;
---
<!doctype html>
<html lang="en" data-scroll-behavior="smooth">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="canonical" href={`https://www.klkoleo.com${Astro.url.pathname}`} />
    <link rel="icon" href="/images/brand/favicon.png" />
    <link rel="preload" href="/fonts/poppins-400.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/poppins-600.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body><HeaderIsland data={data} pathname={Astro.url.pathname} client:load /><main id="main"><slot /></main><FooterIsland data={data} client:load /></body>
</html>
<style is:global>
  @font-face{font-family:Poppins;src:url('/fonts/poppins-400.ttf') format('truetype');font-weight:400;font-display:swap}
  @font-face{font-family:Poppins;src:url('/fonts/poppins-500.ttf') format('truetype');font-weight:500;font-display:swap}
  @font-face{font-family:Poppins;src:url('/fonts/poppins-600.ttf') format('truetype');font-weight:600;font-display:swap}
  @font-face{font-family:Poppins;src:url('/fonts/poppins-700.ttf') format('truetype');font-weight:700;font-display:swap}
  :root{--font-poppins:Poppins}
</style>
